{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Varejo Investidor insight article",
  "type": "object",
  "required": [
    "slug",
    "locale",
    "translationKey",
    "status",
    "title",
    "subtitle",
    "description",
    "category",
    "author",
    "datePublished",
    "dateModified",
    "image",
    "imageAlt",
    "tags",
    "relatedPosts",
    "seoTitle",
    "seoDescription",
    "introduction",
    "blocks"
  ],
  "properties": {
    "status": {
      "enum": ["draft", "review", "scheduled", "published", "archived"]
    },
    "scheduledAt": { "type": "string", "format": "date" },
    "featured": { "type": "boolean" },
    "personaLead": { "enum": ["formiga", "lobo", "harpia"] }
  }
}
