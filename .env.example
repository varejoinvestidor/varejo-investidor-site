# VI Publisher — copie para .env.local e preencha no Supabase (Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor (nunca expor no cliente). Usado em cron e operações privilegiadas.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron — header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Exibição de datas agendadas/publicação no painel
PUBLISHER_SITE_TIMEZONE=America/Sao_Paulo

# Após preencher NEXT_PUBLIC_SUPABASE_URL, o next.config injeta o host em images.remotePatterns no build.
